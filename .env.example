DATABASE_URL=postgresql://cutdesk:cutdesk@localhost:5432/cutdesk
APP_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Google Cloud OAuth client (Web application).
# Enable the Google Drive API, then add this redirect URI on the client:
# http://localhost:3010/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3010/api/google/callback

# Video, audio, and still bytes for new uploads. Relative paths are from the app directory.
# Docker Postgres does not store these files.
STORAGE_DIR=./storage

# Clerk member sign-in (Google). `npx clerk env pull` fills the keys into .env.
# Leave these blank in git. They are separate from the Google Drive client above.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/api/auth/clerk
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/api/auth/clerk
